rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper para verificar administrador de forma segura
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write, list: if isAdmin();
    }

    match /book_codes/{code} {
      allow read: if true;
      allow update: if request.auth != null && (
        isAdmin() || 
        (resource.data.used == false && request.resource.data.used == true && request.resource.data.usedBy == request.auth.uid)
      );
      allow create, delete, list: if isAdmin();
    }

    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write, list: if isAdmin();
    }

    match /material_editions/{editionId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /material_modifications/{modId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /topic_videos/{topicId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // Reglas para dudas no resueltas del Agente BUS (Entrenamiento)
    match /unresolved_dudas/{dudaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reglas para respuestas entrenadas del Agente BUS
    match /trained_answers/{answerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Reglas para el disparador de emails (Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Reglas para el historial de comunicados por email
    match /email_announcements/{announcementId} {
      allow read, list: if request.auth != null;  // Cualquier alumno autenticado puede leer comunicados
      allow write: if isAdmin();
    }

    // Reglas para Consultas de Alumnos al Preparador
    match /student_messages/{msgId} {
      allow create: if request.auth != null;
      allow read, list: if request.auth != null && (
        isAdmin() || resource.data.studentUid == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Reglas para Dudas sin Resolver del Agente BUS (escritura de alumnos)
    match /agente_bus_unresolved/{dudaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reglas para Enlaces Cortos (Tests Compartidos de 4 dígitos)
    match /shared_tests/{testId} {
      allow read: if true; // Permitir que cualquier alumno lea el test usando el ID de 4 dígitos
      allow write: if isAdmin(); // Solo el profesor puede generar los enlaces
    }

    // Reglas para las calificaciones de los alumnos (Tests HTML)
    match /test_results/{resultId} {
      allow create: if request.auth != null;
      allow read, list, update, delete: if isAdmin();
    }

    // Reglas para el seguimiento de actividad y métricas de estudio
    match /activity_tracking/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, list, write: if isAdmin();
    }

  }
}
